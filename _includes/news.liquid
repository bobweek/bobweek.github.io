{% assign news = site.news | sort: "date" | reverse %}
{% assign news_limit = news.size %}
{% if include.limit and site.announcements.limit %}
  {% assign news_limit = site.announcements.limit %}
{% endif %}

<div class="news-feed{% if include.limit and site.announcements.scrollable %} news-feed-scroll{% endif %}"
     role="region" aria-label="News feed" tabindex="0">
  {% for item in news limit: news_limit %}
    <div class="news-entry">
      <div class="news-meta">
        {% if item.display_date %}
          {{ item.display_date }}
        {% else %}
          {{ item.date | date: "%d %B %Y" }}
        {% endif %}
        {% if item.category %}
          &middot; {{ item.category }}
        {% endif %}
      </div>

      {% if item.inline %}
        <div class="news-title">{{ item.title | escape }}</div>
        <div class="news-content">
          {{ item.content }}
        </div>
      {% else %}
        <a class="news-title" href="{{ item.url | relative_url }}">
          {{ item.title | escape }}
        </a>
      {% endif %}
    </div>
  {% else %}
    <p>No news so far.</p>
  {% endfor %}
</div>
