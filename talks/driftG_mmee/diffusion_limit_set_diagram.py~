from pathlib import Path as FilePath

import matplotlib.pyplot as plt
from matplotlib.path import Path as MplPath
from matplotlib.patches import PathPatch, Rectangle


def closed_bezier_path(points):
    """Create a closed path from cubic Bézier segments."""
    vertices = [points[0]]
    codes = [MplPath.MOVETO]

    for control1, control2, endpoint in points[1:]:
        vertices.extend([control1, control2, endpoint])
        codes.extend([MplPath.CURVE4, MplPath.CURVE4, MplPath.CURVE4])

    vertices.append(points[0])
    codes.append(MplPath.CLOSEPOLY)

    return MplPath(vertices, codes)


def main():
    plt.rcParams.update(
        {
            "font.family": "serif",
            "font.serif": ["STIX Two Text", "STIXGeneral", "DejaVu Serif"],
            "mathtext.fontset": "stix",
            "font.size": 20,
            "hatch.linewidth": 0.42,
        }
    )

    fig, ax = plt.subplots(figsize=(9.6, 5.7))

    # Rectangular ambient space X.
    ambient = Rectangle(
        (0.08, 0.12),
        0.84,
        0.76,
        fill=False,
        edgecolor="black",
        linewidth=1.05,
        zorder=1,
    )
    ax.add_patch(ambient)

    # Distinguished subset U_D.
    subset = closed_bezier_path(
        [
            (0.26, 0.52),
            ((0.27, 0.68), (0.40, 0.76), (0.55, 0.73)),
            ((0.69, 0.70), (0.76, 0.60), (0.72, 0.46)),
            ((0.69, 0.33), (0.57, 0.27), (0.43, 0.30)),
            ((0.31, 0.32), (0.23, 0.40), (0.26, 0.52)),
        ]
    )
    ax.add_patch(
        PathPatch(
            subset,
            facecolor="white",
            edgecolor="black",
            linewidth=0.95,
            hatch="////",
            zorder=2,
        )
    )

    # Ambient-space label.
    ax.text(
        0.12,
        0.82,
        r"$X\dots$",
        ha="left",
        va="center",
        fontsize=30,
    )
    ax.text(
        0.18,
        0.82,
        " all individual-based models",
        ha="left",
        va="center",
        fontsize=23,
    )

    # Subset label.
    ax.text(
        0.50,
        0.54,
        r"$U_D$",
        ha="center",
        va="center",
        fontsize=28,
        bbox={"facecolor": "white", "edgecolor": "none", "pad": 1.5},
        zorder=3,
    )
    ax.text(
        0.50,
        0.485,
        "individual-based models with\ncommon diffusion limit " + r"$D$",
        ha="center",
        va="top",
        fontsize=21.5,
        linespacing=1.15,
        bbox={"facecolor": "white", "edgecolor": "none", "pad": 1.0},
        zorder=3,
    )

    ax.set_xlim(0.03, 0.97)
    ax.set_ylim(0.06, 0.94)
    ax.set_aspect("equal")
    ax.axis("off")

    fig.tight_layout(pad=0.25)

    output_dir = FilePath(__file__).resolve().parent
    fig.savefig(
        output_dir / "diffusion_limit_set_diagram.png",
        dpi=300,
        bbox_inches="tight",
        transparent=True,
    )
    fig.savefig(
        output_dir / "diffusion_limit_set_diagram.svg",
        bbox_inches="tight",
        transparent=True,
    )

    plt.show()


if __name__ == "__main__":
    main()
